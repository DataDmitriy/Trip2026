# Public Mapbox token used by the browser (starts with pk.)
# Get one free at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-side Anthropic key for the AI helper.
# Created at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: simple shared password to gate the app (leave empty for open access on family-only deploys)
TRIP_ACCESS_CODE=
